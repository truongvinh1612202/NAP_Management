model PhieuThu {
  id               Int              @id(map: "PK__phieuthu__3214EC0752FBC86A") @default(autoincrement()) @map("Id")
  kyDuLieuId       Int              @map("KyDuLieuId")
  khachHangId      Int              @map("KhachHangId")
  nhanVienId       Int              @map("NhanVienId")
  noiDung          String?          @map("NoiDung") @db.NVarChar(45)
  nhomDoanhThu     String?          @map("NhomDoanhThu") @db.NVarChar(45)
  ngayThu          DateTime?        @map("NgayThu") @db.Date
  soCT             String?          @map("SoCT") @db.NVarChar(45)
  soTien           Float?           @default(0, map: "DF__phieuthu__SoTien__114A936A") @map("SoTien")
  thuQuy           String?          @map("ThuQuy") @db.NVarChar(150)
  tenKhachHang     String?          @map("TenKhachHang") @db.NVarChar(200)
  tenNhanVien      String?          @map("TenNhanVien") @db.NVarChar(200)
  quyenSo          Int?             @map("QuyenSo")
  thuQuyId         Int?             @map("ThuQuyId")
  danhMucKhachHang DanhMucKhachHang @relation(fields: [khachHangId], references: [id], onUpdate: NoAction, map: "FK_phieuthu_danhmuckhachhang")
  danhMucNhanVien  DanhMucNhanVien  @relation(fields: [nhanVienId], references: [id], onUpdate: NoAction, map: "FK_phieuthu_danhmucnhanvien")
  kyDuLieu         KyDuLieu         @relation(fields: [kyDuLieuId], references: [id], onUpdate: NoAction, map: "FK_phieuthu_kydulieu")

  @@map("phieuthu")
}

model QuanLyPhiDichVu {
  id          Int       @id(map: "PK__quanlyph__3214EC07B09AC963") @default(autoincrement()) @map("Id")
  khachHangId Int       @map("KhachHangId")
  phiDichVu   Float?    @map("PhiDichVu")
  ngayHieuLuc DateTime? @map("NgayHieuLuc") @db.Date
  ghiChu      String?   @map("GhiChu") @db.NVarChar(245)

  @@map("quanlyphidichvu")
}

model SysDiagrams {
  name        String @db.NVarChar(128)
  principalId Int    @map("principal_id")
  diagramId   Int    @id(map: "PK__sysdiagr__C2B05B61EEBC26F5") @default(autoincrement()) @map("diagram_id")
  version     Int?
  definition  Bytes?

  @@unique([principalId, name], map: "UK_principal_name")
  @@map("sysdiagrams")
}
