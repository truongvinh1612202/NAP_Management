  nhanVienNSLId  Int?    @map("NhanVienNSL_Id")
  nhanVienLSId   Int?    @map("NhanVienLS_Id")
  phiQLKH        Float?  @map("PhiQLKH")
  phiNSL         Float?  @map("PhiNSL")
  phiLSo         Float?  @map("PhiLSo")
  ngungDV        Int?    @default(0, map: "DF_ds_qltnam_NgungDV") @map("NgungDV")

  @@map("ds_qltnam")
}

model KyDuLieu {
  id       Int        @id(map: "PK__kydulieu__3214EC07E62DF730") @map("Id")
  noiDung  String     @map("NoiDung") @db.NVarChar(200)
  tuNgay   DateTime?  @map("TuNgay") @db.Date
  denNgay  DateTime?  @map("DenNgay") @db.Date
  tonQuy   Float?     @map("TonQuy")
  lockdata Int?       @map("lockdata")
  phieuThu PhieuThu[]

  @@map("kydulieu")
}

model NghiemThuCongViec {
  id          Int       @id(map: "PK__nghiemth__3214EC07DBC6DDB9") @map("Id")
  noiDung     String?   @map("Noidung") @db.NVarChar(145)
  khachHangId Int?      @map("KhachhangId")
  nhanVienId  Int?      @map("NhanvienId")
  congViecId  Int?      @map("CongviecId")
  khachHang   String?   @map("Khachhang") @db.NVarChar(145)
  nhanVien    String?   @map("Nhanvien") @db.NVarChar(45)
  congViec    String?   @map("Congviec") @db.NVarChar(45)
  ngay        DateTime? @map("Ngay") @db.Date
