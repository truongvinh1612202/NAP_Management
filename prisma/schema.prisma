}

model PhaiThu {
  id           Int       @id(map: "PK__phaithu__3214EC07ED386CD4") @default(autoincrement()) @map("Id")
  kyKeToanId   Int       @map("KyKeToanId")
  khachHangId  Int       @map("KhachHangId")
  nhanVienId   Int       @map("NhanVienId")
  soTien       Float     @map("SoTien")
  noiDung      String?   @map("NoiDung") @db.NVarChar(145)
  tenNhanVien  String?   @map("TenNhanVien") @db.NVarChar(65)
  tenKhachHang String?   @map("TenKhachHang") @db.NVarChar(145)
  ngayCT       DateTime? @map("NgayCT") @db.Date
  ghiChu       String?   @map("Ghichu") @db.VarChar(150)
  nguoiLap     String?   @map("NguoiLap") @db.NVarChar(45)
  maSoThue     String?   @map("MaSoThue") @db.NVarChar(150)

  @@map("phaithu")
}

model PhieuChi {
  id           Int       @id(map: "PK_phieuchi") @default(autoincrement()) @map("Id")
  kyDuLieuId   Int?      @map("KyDuLieuId")
  userId       Int?      @map("UserId")
  nhanVienId   Int       @map("NhanVienId")
  noiDung      String?   @map("NoiDung") @db.NVarChar(245)
  nhomChi      String?   @map("NhomChi") @db.NVarChar(45)
  ngayChi      DateTime? @map("NgayChi") @db.Date
  soCT         String?   @map("SoCT") @db.NVarChar(45)
  soTien       Float?    @default(0, map: "DF_phieuchi_SoTien") @map("SoTien")
  thuQuy       String?   @map("ThuQuy") @db.NVarChar(150)
  tenKhachHang String?   @map("TenKhachHang") @db.NVarChar(200)
  tenNhanVien  String?   @map("TenNhanVien") @db.NVarChar(200)
  quyenSo      Int?      @map("QuyenSo")
  thuQuyId     Int?      @map("ThuQuyid")

  @@map("phieuchi")
}

model PhieuChi1 {
  id           Int       @id(map: "PK__phieuchi__3214EC0722E463CF") @default(autoincrement()) @map("Id")
  kyDuLieuId   Int?      @map("KyDuLieuId")
  userId       Int?      @map("UserId")
  nhanVienId   Int       @map("NhanVienId")
