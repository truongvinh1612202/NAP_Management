}

model DsQltNam {
  id             Int     @id(map: "PK__ds_qltna__3214EC0736D1433B") @map("Id")
  nam            Int     @map("Nam")
  stt            Int     @map("Stt")
  khachHangId    Int     @map("KhachHangId")
