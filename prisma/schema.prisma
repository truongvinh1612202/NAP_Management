datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model chiphicongviec {
  Id           Int     @id(map: "PK__chiphico__3214EC07DCBA1C02")
  TenKhachHang String? @db.NVarChar(150)
  CongViec_Id  Int?
  Tencongviec  String? @db.NVarChar(50)
  chiphi       Float?
  Mota         String? @db.NVarChar(50)
  kh_Id        String? @db.NVarChar(50)
}

model danhmuccongviec {
  Id   Int     @id(map: "PK__danhmucc__3214EC073F469048")
  Ten  String  @db.NVarChar(50)
  MoTa String? @db.NVarChar(150)
}

model danhmuckhachhang {
  Id                Int        @id(map: "PK__danhmuck__3214EC074E770AD8")
  TenKhachHang      String     @db.NVarChar(150)
  MaSoThue          String     @db.NVarChar(150)
  DiaChi            String?    @db.NVarChar(300)
  PhiDichVu         Float?
  KyKhaiThue        String?    @db.NVarChar(15)
  KyNhanCT          String?    @db.NVarChar(45)
  DienThoai         String?    @db.NVarChar(45)
  Email             String?    @db.NVarChar(100)
  NganhKD           String?    @db.NVarChar(150)
  CQTquanly         String?    @db.NVarChar(45)
  TrangThai         String?    @db.NVarChar(40)
  GiamDoc           String?    @db.NVarChar(45)
  NhanVienDVKH      String?    @db.NVarChar(45)
  NhanVienLapSo     String?    @db.NVarChar(45)
  TrangThaiHoatDong String?    @db.NVarChar(45)
  NhanVienDVKH_Id   Int?
  NhanVienLapSo_Id  Int?
  NhanVienNSL_Id    Int?
  NhanVienNSL       String?    @db.VarChar(45)
  phieuthu          phieuthu[]
}

model danhmucnhanvien {
  Id           Int        @id(map: "PK__danhmucn__3214EC0797722030") @default(autoincrement())
  MaSoNhanVien String     @db.NVarChar(50)
  TenNhanVien  String?    @db.NVarChar(150)
  NamSinh      DateTime?  @db.Date
  DienThoai    String?    @db.NVarChar(45)
  ThuongTru    String?    @db.NVarChar(200)
  UserDangNhap String?    @db.NVarChar(45)
  phieuthu     phieuthu[]
}

model dichvukhachhang {
  Id          Int       @id(map: "PK__dichvukh__3214EC0706D0E3EB") @default(autoincrement())
  NhanVienId  Int
  KhachHangId Int
  NgayBanGiao DateTime? @db.Date
}

model ds_qlcnam {
  Id          Int     @id(map: "PK__ds_qlcna__3214EC07DAB3DECB")
  nam         Int
  stt         Int
  NhanvienId  Int
  TenNhanvien String? @db.NVarChar(150)
}

model ds_qltnam {
  Id              Int     @id(map: "PK__ds_qltna__3214EC0736D1433B")
  Nam             Int
  Stt             Int
  KhachHangId     Int
  TenKhachHang    String  @db.NVarChar(200)
  PhiDV           Float?
  GhiChu          String? @db.NVarChar(145)
  DauKy           Float?
  KhaiThue        String? @db.NVarChar(45)
  NhanHS          String? @db.NVarChar(45)
  NhanVienDVKH_Id Int?
  NhanVienNSL_Id  Int?
  NhanVienLS_Id   Int?
  PhiQLKH         Float?
  PhiNSL          Float?
  PhiLSo          Float?
  NgungDV         Int?    @default(0, map: "DF_ds_qltnam_NgungDV")
}

model kydulieu {
  Id       Int        @id(map: "PK__kydulieu__3214EC07E62DF730")
  NoiDung  String     @db.NVarChar(200)
  TuNgay   DateTime?  @db.Date
  DenNgay  DateTime?  @db.Date
  TonQuy   Float?
  lockdata Int?
  phieuthu phieuthu[]
}

model nghiemthucongviec {
  Id          Int       @id(map: "PK__nghiemth__3214EC07DBC6DDB9")
  Noidung     String?   @db.NVarChar(145)
  KhachhangId Int?
  NhanvienId  Int?
  CongviecId  Int?
  Khachhang   String?   @db.NVarChar(145)
  Nhanvien    String?   @db.NVarChar(45)
  Congviec    String?   @db.NVarChar(45)
  Ngay        DateTime? @db.Date
  Sotien      Float?
  Kydulieu    String?   @db.NVarChar(45)
}

model noidungchi {
  Id      Int    @id(map: "PK__noidungc__3214EC07AB6E2050")
  NoiDung String @db.NVarChar(200)
}

model noidungthu {
  Id      Int    @id(map: "PK__noidungt__3214EC0770FAC5FD")
  NoiDung String @db.NVarChar(200)
}

model phaithu {
  Id           Int       @id(map: "PK__phaithu__3214EC07ED386CD4") @default(autoincrement())
  KyKeToanId   Int
  KhachHangId  Int
  NhanVienId   Int
  SoTien       Float
  NoiDung      String?   @db.NVarChar(145)
  TenNhanVien  String?   @db.NVarChar(65)
  TenKhachHang String?   @db.NVarChar(145)
  NgayCT       DateTime? @db.Date
  Ghichu       String?   @db.VarChar(150)
  NguoiLap     String?   @db.NVarChar(45)
  MaSoThue     String?   @db.NVarChar(150)
}

model phieuchi {
  Id           Int       @id(map: "PK_phieuchi") @default(autoincrement())
  KyDuLieuId   Int?
  UserId       Int?
  NhanVienId   Int
  NoiDung      String?   @db.NVarChar(245)
  NhomChi      String?   @db.NVarChar(45)
  NgayChi      DateTime? @db.Date
  SoCT         String?   @db.NVarChar(45)
  SoTien       Float?    @default(0, map: "DF_phieuchi_SoTien")
  ThuQuy       String?   @db.NVarChar(150)
  TenKhachHang String?   @db.NVarChar(200)
  TenNhanVien  String?   @db.NVarChar(200)
  QuyenSo      Int?
  ThuQuyid     Int?
}

model phieuchi1 {
  Id           Int       @id(map: "PK__phieuchi__3214EC0722E463CF") @default(autoincrement())
  KyDuLieuId   Int?
  UserId       Int?
  NhanVienId   Int
  NoiDung      String?   @db.NVarChar(245)
  NhomChi      String?   @db.NVarChar(45)
  NgayChi      DateTime? @db.Date
  SoCT         String?   @db.NVarChar(45)
  SoTien       Float?    @default(0, map: "DF__phieuchi__SoTien__05D8E0BE")
  ThuQuy       String?   @db.NVarChar(150)
  TenKhachHang String?   @db.NVarChar(200)
  TenNhanVien  String?   @db.NVarChar(200)
  QuyenSo      Int?
  ThuQuyid     Int?
}

model phieuthu {
  Id               Int              @id(map: "PK__phieuthu__3214EC0752FBC86A") @default(autoincrement())
  KyDuLieuId       Int
  KhachHangId      Int
  NhanVienId       Int
  NoiDung          String?          @db.NVarChar(45)
  NhomDoanhThu     String?          @db.NVarChar(45)
  NgayThu          DateTime?        @db.Date
  SoCT             String?          @db.NVarChar(45)
  SoTien           Float?           @default(0, map: "DF__phieuthu__SoTien__114A936A")
  ThuQuy           String?          @db.NVarChar(150)
  TenKhachHang     String?          @db.NVarChar(200)
  TenNhanVien      String?          @db.NVarChar(200)
  QuyenSo          Int?
  ThuQuyId         Int?
  danhmuckhachhang danhmuckhachhang @relation(fields: [KhachHangId], references: [Id], onUpdate: NoAction, map: "FK_phieuthu_danhmuckhachhang")
  danhmucnhanvien  danhmucnhanvien  @relation(fields: [NhanVienId], references: [Id], onUpdate: NoAction, map: "FK_phieuthu_danhmucnhanvien")
  kydulieu         kydulieu         @relation(fields: [KyDuLieuId], references: [Id], onUpdate: NoAction, map: "FK_phieuthu_kydulieu")
}

model quanlyphidichvu {
  Id          Int       @id(map: "PK__quanlyph__3214EC07B09AC963") @default(autoincrement())
  KhachHangId Int
  PhiDichVu   Float?
  NgayHieuLuc DateTime? @db.Date
  GhiChu      String?   @db.NVarChar(245)
}

model sysdiagrams {
  name         String @db.NVarChar(128)
  principal_id Int
  diagram_id   Int    @id(map: "PK__sysdiagr__C2B05B61EEBC26F5") @default(autoincrement())
  version      Int?
  definition   Bytes?

  @@unique([principal_id, name], map: "UK_principal_name")
}
