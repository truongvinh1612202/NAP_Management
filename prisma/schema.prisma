datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  output        = "../generated/client"
  binaryTargets = ["native", "darwin", "darwin-arm64"]
}

model Employee {
  id       Int    @id @default(autoincrement())
  fullName String

  companyAssignments CompanyEmployee[]
  enteredBatches     PaymentBatch[]
}

model Company {
  id          Int    @id @default(autoincrement())
  companyName String
  taxId       String @unique
  serviceFee  Float?

  employeeAssignments CompanyEmployee[]
  payments            Payment[]
}

enum EmployeeRole {
  LAP_SO
  NHAP_SO_LIEU
  DICH_VU_KH
}

model CompanyEmployee {
  id         Int          @id @default(autoincrement())
  companyId  Int
  employeeId Int
  role       EmployeeRole

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([companyId, employeeId, role])
}

model Payment {
  id               Int      @id @default(autoincrement())
  companyId        Int
  month            Int
  year             Int
  note             String?
  amount           Float?
  collectionDate   DateTime?
  batchId          Int?

  company Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  batch   PaymentBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@unique([companyId, month, year])
}

// Một "phiếu thu" = 1 đợt "Thu nhiều công ty" (gom nhiều payment).
model PaymentBatch {
  id             Int       @id @default(autoincrement()) // = "mã phiếu"
  createdAt      DateTime  @default(now()) // giờ tạo
  collectionDate DateTime? // ngày thu của phiếu
  month          Int // kỳ T/Q (1 tháng/phiếu)
  year           Int
  note           String? // ghi chú / tên phiếu
  isComplete     Boolean   @default(false) // tự đánh dấu "đã xong"
  enteredById    Int? // "người nhập" (nhân viên)

  enteredBy Employee? @relation(fields: [enteredById], references: [id], onDelete: SetNull)
  payments  Payment[]
}
