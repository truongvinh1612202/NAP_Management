datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}
generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
  binaryTargets = ["native", "darwin", "darwin-arm64"]
}

model ChiPhiCongViec {
  id           Int     @id(map: "PK__chiphico__3214EC07DCBA1C02") @map("Id")
  tenKhachHang String? @map("TenKhachHang") @db.NVarChar(150)
  congViecId   Int?    @map("CongViec_Id")
  tenCongViec  String? @map("Tencongviec") @db.NVarChar(50)
  chiPhi       Float?  @map("chiphi")
  moTa         String? @map("Mota") @db.NVarChar(50)
  khId         String? @map("kh_Id") @db.NVarChar(50)

  @@map("chiphicongviec")
}

model DanhMucCongViec {
  id   Int     @id(map: "PK__danhmucc__3214EC073F469048") @map("Id")
  ten  String  @map("Ten") @db.NVarChar(50)
  moTa String? @map("MoTa") @db.NVarChar(150)

  @@map("danhmuccongviec")
}

model DanhMucKhachHang {
  id                Int        @id(map: "PK__danhmuck__3214EC074E770AD8") @map("Id")
  tenKhachHang      String     @map("TenKhachHang") @db.NVarChar(150)
  maSoThue          String     @map("MaSoThue") @db.NVarChar(150)
  diaChi            String?    @map("DiaChi") @db.NVarChar(300)
  phiDichVu         Float?     @map("PhiDichVu")
  kyKhaiThue        String?    @map("KyKhaiThue") @db.NVarChar(15)
  kyNhanCT          String?    @map("KyNhanCT") @db.NVarChar(45)
  dienThoai         String?    @map("DienThoai") @db.NVarChar(45)
  email             String?    @map("Email") @db.NVarChar(100)
  nganhKD           String?    @map("NganhKD") @db.NVarChar(150)
  cqtQuanLy         String?    @map("CQTquanLy") @db.NVarChar(45)
  trangThai         String?    @map("TrangThai") @db.NVarChar(40)
  giamDoc           String?    @map("GiamDoc") @db.NVarChar(45)
  nhanVienDVKH      String?    @map("NhanVienDVKH") @db.NVarChar(45)
  nhanVienLapSo     String?    @map("NhanVienLapSo") @db.NVarChar(45)
  trangThaiHoatDong String?    @map("TrangThaiHoatDong") @db.NVarChar(45)
  nhanVienDVKHId    Int?       @map("NhanVienDVKH_Id")
  nhanVienLapSoId   Int?       @map("NhanVienLapSo_Id")
  nhanVienNSLId     Int?       @map("NhanVienNSL_Id")
  nhanVienNSL       String?    @map("NhanVienNSL") @db.VarChar(45)
  phieuThu          PhieuThu[]

  @@map("danhmuckhachhang")
}

model DanhMucNhanVien {
  id           Int        @id(map: "PK__danhmucn__3214EC0797722030") @default(autoincrement()) @map("Id")
  maSoNhanVien String     @map("MaSoNhanVien") @db.NVarChar(50)
  tenNhanVien  String?    @map("TenNhanVien") @db.NVarChar(150)
  namSinh      DateTime?  @map("NamSinh") @db.Date
  dienThoai    String?    @map("DienThoai") @db.NVarChar(45)
  thuongTru    String?    @map("ThuongTru") @db.NVarChar(200)
  userDangNhap String?    @map("UserDangNhap") @db.NVarChar(45)
  phieuThu     PhieuThu[]

  @@map("danhmucnhanvien")
}

model DichVuKhachHang {
  id          Int       @id(map: "PK__dichvukh__3214EC0706D0E3EB") @default(autoincrement()) @map("Id")
  nhanVienId  Int       @map("NhanVienId")
  khachHangId Int       @map("KhachHangId")
  ngayBanGiao DateTime? @map("NgayBanGiao") @db.Date

  @@map("dichvukhachhang")
}

model DsQlcNam {
  id          Int     @id(map: "PK__ds_qlcna__3214EC07DAB3DECB") @map("Id")
  nam         Int     @map("nam")
  stt         Int     @map("stt")
  nhanVienId  Int     @map("NhanvienId")
  tenNhanVien String? @map("TenNhanvien") @db.NVarChar(150)

