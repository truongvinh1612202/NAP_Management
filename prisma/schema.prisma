datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  output        = "../generated/client"
  binaryTargets = ["native", "darwin", "darwin-arm64"]
}

model Employee {
  id       Int    @id @default(autoincrement())
  fullName String

  companyAssignments CompanyEmployee[]
}

model Company {
  id          Int    @id @default(autoincrement())
  companyName String
  taxId       String @unique
  serviceFee  Float?

  employeeAssignments CompanyEmployee[]
  payments            Payment[]
}

enum EmployeeRole {
  LAP_SO
  NHAP_SO_LIEU
  DICH_VU_KH
}

model CompanyEmployee {
  id         Int          @id @default(autoincrement())
  companyId  Int
  employeeId Int
  role       EmployeeRole

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([companyId, employeeId, role])
}

model Payment {
  id        Int     @id @default(autoincrement())
  companyId Int
  month     Int
  year      Int
  note      String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, month, year])
}
